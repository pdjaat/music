# ---------------------------------------------------------------------------
# Sangeet (संगीत) — server environment variables
# Copy to server/.env (or export) and adjust.
# ---------------------------------------------------------------------------

# Port the API listens on
PORT=4000

# Comma-separated list of allowed browser origins for the API (use * for dev)
CLIENT_ORIGIN=*

# --- SECURITY ---
# JWT signing secret. MUST be a long random string in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Token lifetime
JWT_EXPIRES_IN=30d

# --- MUSIC PROVIDERS ---
# Primary provider: 'youtube' (full-length playback via the official embed).
# Discovery/search requires a YouTube Data API v3 key.
YOUTUBE_API_KEY=

# Fallback provider used when the primary is not configured/unreachable:
# 'internetarchive' (keyless, full-length public-domain / CC audio).
MUSIC_PROVIDER_PRIMARY=youtube
MUSIC_PROVIDER_FALLBACK=internetarchive

# Provider request timeout (ms)
PROVIDER_TIMEOUT_MS=3500

# Cache TTLs (seconds)
CACHE_SEARCH_S=21600
CACHE_TRENDING_S=3600
CACHE_NEW_S=3600
CACHE_DETAIL_S=86400
CACHE_RADIO_S=1800

# --- ADMIN BOOTSTRAP ---
# On first boot the account with this email is created (or promoted) as admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose-a-strong-password

# --- DATABASE ---
# SQLite is used by default (server/data/sangeet.db). For PostgreSQL, see
# docs/DATABASE.md — the schema is portable and can be created 1:1.
DATA_DIR=./data

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- WEB (vite build) ---
# The web app reads no secrets; it talks to the API via the same origin
# (/api proxy in dev, static hosting in prod).
#
# When the frontend is deployed statically (e.g. Vercel) and the API lives
# elsewhere, set this at BUILD time so the client calls the hosted API:
VITE_API_BASE=
